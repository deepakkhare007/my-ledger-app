# Copy to .env.local and fill in your own values. Never commit .env.local —
# it's already in .gitignore. Every account/key below is yours to create;
# nothing here was created or used by Claude.

# --- Supabase (create a project at https://supabase.com) -------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API > service_role key. Server-only, bypasses RLS —
# never expose this to the client or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (test mode keys first — https://dashboard.razorpay.com) ------
# Test keys start with rzp_test_; switch to rzp_live_ only in replica-deploy.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Account & Settings > Webhooks > create one for payment_link.paid,
# pointing at /api/webhooks/razorpay. This is the secret shown there, a
# DIFFERENT value from RAZORPAY_KEY_SECRET above.
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp Business Cloud API (official Meta API) -----------------------
# Meta for Developers > your app > WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# App Dashboard > Settings > Basic > App Secret — used to verify inbound
# webhook signatures (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# Any string you choose; enter the SAME value when registering the webhook
# URL (/api/webhooks/whatsapp) in the Meta dashboard.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- MSG91 (SMS fallback — https://msg91.com) -------------------------------
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
