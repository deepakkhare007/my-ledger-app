# Copy to .env.local and fill in your own values. Never commit .env.local —
# it's already in .gitignore. Every account/key below is yours to create;
# nothing here was created or used by Claude.

# --- Supabase (create a project at https://supabase.com) -------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API > service_role key. Server-only, bypasses RLS —
# never expose this to the client or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (test mode keys first — https://dashboard.razorpay.com) ------
# Test keys start with rzp_test_; switch to rzp_live_ only in replica-deploy.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Account & Settings > Webhooks > create one for payment_link.paid,
# pointing at /api/webhooks/razorpay. This is the secret shown there, a
# DIFFERENT value from RAZORPAY_KEY_SECRET above.
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp Business Cloud API (official Meta API) -----------------------
# Meta for Developers > your app > WhatsApp > API Setup.
# Two approved message templates are needed in Meta Business Manager before
# sends will work: "payment_reminder" (src/lib/whatsapp.ts sendWhatsAppReminder)
# and "transaction_receipt" (sendWhatsAppBill, for the "Send bill" button).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# App Dashboard > Settings > Basic > App Secret — used to verify inbound
# webhook signatures (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# Any string you choose; enter the SAME value when registering the webhook
# URL (/api/webhooks/whatsapp) in the Meta dashboard.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- MSG91 (SMS fallback — https://msg91.com) -------------------------------
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Separate DLT-registered template for bill-copy sends (different wording
# from the reminder template above) — see src/lib/sms.ts sendSmsBill.
MSG91_BILL_TEMPLATE_ID=

# --- Dev-only OTP bypass (local testing only — NEVER set in production) ---
# Local Supabase phone auth only works for the two numbers seeded in
# supabase/config.toml's [auth.sms.test_otp]. Set this to accept that one
# fixed code for ANY phone number instead, so you don't have to remember
# the seeded numbers while testing. Leave unset normally; also hard-guarded
# by NODE_ENV !== "production" in src/lib/actions.ts, so even an accidental
# value here can't activate a real deployment.
DEV_OTP_BYPASS_CODE=

# --- Anthropic (voice entry NLU — https://console.anthropic.com) -----------
# Only used server-side by src/lib/voice.ts to parse a spoken transaction
# ("Ramesh ko 500 rupaye diye") into structured fields. Small, cheap model
# (claude-haiku-5-5); this is the one per-request paid API call in the app.
ANTHROPIC_API_KEY=
